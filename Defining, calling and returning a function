def arithematic(num1, num2):
    add = num1 + num2
    sub = num1 - num2
    mul = num1 * num2
    return add, sub, mul

num1 = int(input("Enter your 1st number: "))
num2 = int(input("Enter your 2nd number: "))

add, sub, mul = arithematic(num1, num2)
print(f"The sum of your numbers is {add}")
print(f"The difference of your numbers is {sub}")
print(f"The product of your numbers is {mul}")
