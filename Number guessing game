import random
num = 1
secret_number = random.randint(1,50)
attempts = 5
print("Welcome to the number guessing game!!")
print("The secret number is between 1 and 50, guess within 5 chances")
while num <= 50:
    print(f"You have {attempts} attempts to guess")
    user_number = int(input("Enter your guess: "))
    if user_number == secret_number:
        print(f"Congrats, your guess {user_number}, matches with our secret number")
        break
    else:
        if user_number < secret_number:
            higher_or_lower = "higher"
            print(f"Your guess is wrong, try {higher_or_lower}")
        else:
            higher_or_lower = "lower"
            print(f"Your guess is wrong, try {higher_or_lower}")
    num +=1
    attempts -=1
    if attempts < 1:
        print("You have exhausted all your attempts")
        break
print("GAME OVER!!")
